    <action>
      <sql>UPDATE control.etl_audit
SET
    run_end_ts = CURRENT_TIMESTAMP,
    status = 'SUCCESS',
    message = 'fact_sales pipeline completed successfully'
WHERE audit_id = (
    SELECT audit_id
    FROM control.etl_audit
    WHERE pipeline_name = 'fact_sales'
      AND status = 'RUNNING'
    ORDER BY run_start_ts DESC
    LIMIT 1
);</sql>
