        <length>9</length>
        <precision>0</precision>
        <currency>$</currency>
        <decimal>.</decimal>
        <group>,</group>
        <nullif/>
        <trim_type>none</trim_type>
        <roundingType>half_even</roundingType>
      </field>
      <field>
        <name>unit_price</name>
        <type>Number</type>
        <format>####0.0#########;-####0.0#########</format>
        <length>12</length>
        <precision>2</precision>
        <currency>$</currency>
        <decimal>.</decimal>
        <group>,</group>
        <nullif/>
        <trim_type>none</trim_type>
        <roundingType>half_even</roundingType>
      </field>
      <field>
